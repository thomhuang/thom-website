# Loaded only by `react-scripts start` (NODE_ENV=development).
# Production builds use .env.production, which sets REACT_APP_API_URL=/api so
# the website Worker can proxy same-origin. Keep dev-only overrides here and
# never in .env.local: CRA loads .env.local for builds too, and it outranks
# .env.production.
REACT_APP_API_URL=http://localhost:4000
