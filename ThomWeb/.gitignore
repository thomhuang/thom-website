# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.vscode

# Environment files: only .env.example is tracked. REACT_APP_API_URL has a
# documented default in src/api/config.ts, so no local env file is required.
.env*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
