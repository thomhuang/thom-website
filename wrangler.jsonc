{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thom-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./ThomWeb/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "thom-server"
    }
  ]
}
